# portal-hospital-v2-dev — credenciales app Web (gitignored vía *.local)
# 1) Consola Firebase → proyecto portal-hospital-v2-dev → App Web → copiar firebaseConfig
# 2) Renombrá / copiá a `.env.v2.dev.local` en la raíz del repo
# 3) Arranque: `npm run dev:web:dev`  (NO uses `dev:web` — ese apunta a prod vía `.env.v2.local`)

VITE_V2_FIREBASE_API_KEY=
VITE_V2_FIREBASE_AUTH_DOMAIN=portal-hospital-v2-dev.firebaseapp.com
VITE_V2_FIREBASE_PROJECT_ID=portal-hospital-v2-dev
VITE_V2_FIREBASE_STORAGE_BUCKET=portal-hospital-v2-dev.firebasestorage.app
VITE_V2_FIREBASE_MESSAGING_SENDER_ID=
VITE_V2_FIREBASE_APP_ID=
# Opcional
# VITE_V2_FIREBASE_MEASUREMENT_ID=

# Scripts Node contra-dev (opcional):
# FIREBASE_V2_PROJECT_ID=portal-hospital-v2-dev
# GOOGLE_APPLICATION_CREDENTIALS=C:\ruta\service-account-v2-dev.json
